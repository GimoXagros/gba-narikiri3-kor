    },
    {
      "id": "dialogue-terms-1a0748",
      "text": "젤로스\n전생의문",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1a0788",
      "text": "젤로스\n레미유적지하３Ｆ",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1a07c8",
      "text": "젤로스\n엘프　숲／냥인　마을／총영주　관저",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1a0808",
      "text": "젤로스\n인간목장",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1a0a08",
      "text": "젤로스\n부유요새",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1a0a48",
      "text": "젤로스\n엔딩",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1a30c4",
      "text": "있지,로이드와　콜레트는\n전설에서　이어지는　걸까?%k\n언니,좀　흥미진진하거든",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1a66c0",
      "text": "로이드와　콜레트가　무사했으니\n자잘한　건　됐잖아",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1a8480",
      "text": "해롤드는　전설에　따라\n성별이　다르대,알고　있었어?",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1ad460",
      "text": "로이드와　콜레트대신\n성당에서　악마를　몰아내자",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1add80",
      "text": "심포니아　전설의　영웅\n젤로스와　시이나가…",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1afe80",
      "text": "로이드와　콜레트의　대역으로\n가줄　수　있겠니?",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1b1e8c",
      "text": "\n『로이드와　콜레트가\n여행을　떠난　며칠　후』",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1b1ec4",
      "text": "『그러나　로이드,콜레트는\n시간이　지나도　돌아오지　않았다』",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1b2064",
      "text": "『로이드와　콜레트는　많은　동료들을\n이끌고　돌아왔다』",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1b2444",
      "text": "『지하　감옥에서　탈출한\n아체와　클라스는…』",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1b24e4",
      "text": "『아체와　클라스가　잡혀있던\n감옥을　연　것은…』",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1b2a3c",
      "text": "『파라와　킬이　미끼가　되어\n적을　끌어들였습니다』",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1b2a7c",
      "text": "『그　틈에　리드는　함정에\n빠진　동료들을　구해　내고』",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1b37ec",
      "text": "『그때　절망의　세레스티아에\n지혜의　여신　해롤드가…』",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1b39bc",
      "text": "『젤로스,시이나라는　\n소문이었습니다』인가…",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1b3aa4",
      "text": "젤로스와　시이나의\n의혹은　플린걸까?",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1b3b2c",
      "text": "『그　중　대단했던　것은　\n젤로스와　시이나였습니다』",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1b3b5c",
      "text": "『젤로스와　시이나는　１００명\n몫을　했다고　평가되었습니다』",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "meredy-ruins-floor",
      "text": "메르디\n레미유적　지하１층",
      "review": "original_J_identity_and_floor_checked_natural_play_pending"
    },
    {
      "id": "dialogue-terms-1ac028",
      "text": "나는　리드,이　쪽　두　사람은\n소꿉친구인　파라와　킬",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-terms-1ac190",
      "text": "내　이름은　로이드・어빙\n이　쪽이　콜레트와　지니어스",
      "review": "source_name_identity_user_wording_and_attached_particles_verified_layout_pending"
    },
    {
      "id": "dialogue-context-160c88",
      "text": "악당　@B에게\n빛의　열쇠를　빼앗겼다!",
      "basis": "Restore the identity of the alternate protagonist who steals the light key.",
      "review": "source_context_reviewed_original_consumer_and_pixels_pending"
    },
    {
      "id": "dialogue-context-1674e8",
      "text": "@G의　연락을　기다려야하나?\n언제까지…?",
      "basis": "Restore which separated teammate must send the signal.",
      "review": "source_context_reviewed_original_consumer_and_pixels_pending"
    },
    {
      "id": "dialogue-context-167f58",
      "text": "@G의　연락을　기다려야하나?\n언제까지…?",
      "basis": "Same original line in the alternate stored scene; preserve its independent VM record.",
      "review": "source_context_reviewed_original_consumer_and_pixels_pending"
    },
    {
      "id": "dialogue-context-1891b8",
      "text": "내일은　오늘보다　큰일…\n그건　@G의　입버릇인가?",
      "basis": "Restore the owner of the recurring catchphrase.",
      "review": "source_context_reviewed_original_consumer_and_pixels_pending"
    },
    {
      "id": "dialogue-context-19a8b0",
      "text": "@G의　말처럼\n내일은　오늘보다　큰일이니까%k\n１００일분의　내일을　보고　있다고\n적이　강할　수밖에　없어",
      "basis": "Restore the specifically referenced speaker of the catchphrase; retain all existing waits.",
      "review": "source_context_reviewed_original_consumer_and_pixels_pending"
    },
    {
      "id": "dialogue-context-19a8f0",
      "text": "@G의　말처럼\n내일은　오늘보다　큰일이니까%k\n１００일분의　내일을　보고　있다고\n적이　강할　수밖에　없어",
      "basis": "Same catchphrase reference in another independent VM record.",
      "review": "source_context_reviewed_original_consumer_and_pixels_pending"
    },
    {
      "id": "dialogue-context-19c524",
      "text": "은발의　젊은　남자　봤어?\n새로운　영웅이라　생각하는데…%k\n@G의　말솜씨로　잘　구슬려서\n동료로　만들어봐!",
      "basis": "Restore Caro as the teammate whose persuasive speaking is specifically requested.",
      "review": "source_context_reviewed_original_consumer_and_pixels_pending"
    },
    {
      "id": "dialogue-context-19d640",
      "text": "이상하네…　리필　선생님네\n분명　@B,@G와　함께%k\n@D호에　탔는데…\n어?　저　@D호,색이…",
      "basis": "Restore the two witnessed companions, a plot clue distinguishing the two ships/worlds.",
      "review": "source_context_reviewed_original_consumer_and_pixels_pending"
    },
    {
      "id": "dialogue-context-1ae330",
      "text": "안쪽　문까지　데려다　줘\n그리고　@G의　연락을　기다려",
      "basis": "Restore the named sender of the signal in the escort instruction.",
      "review": "source_context_reviewed_original_consumer_and_pixels_pending"
    },
    {
      "id": "dialogue-context-1b3e9c",
      "text": "『괴인　@B에게서\n빛의　열쇠를　지키기　위해…』",
      "basis": "Restore the named opponent in the quoted account, plus the original unfinished quotation.",
      "review": "source_context_reviewed_original_consumer_and_pixels_pending"
    },
    {
      "id": "dialogue-context-1b406c",
      "text": "『괴인　@B에게서　훌륭하게\n되찾았습니다.그러나…』",
      "basis": "Original 奪い返しました means recaptured, not simply took; retain the quoted opponent.",
